# Copiar este archivo a .env y ajustar valores segun el entorno.

# Ruta al archivo .clp con las reglas del sistema experto.
CLIPS_RULES_PATH=logica/reglas.clp

# Origenes permitidos por CORS, como lista JSON (nunca usar ["*"] en prod).
CORS_ALLOWED_ORIGINS=["http://localhost:3000"]

# Nivel de logging raiz: DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO

# Entorno de ejecucion: dev (logs legibles) | prod (logs JSON estructurados)
ENVIRONMENT=dev
